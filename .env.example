# API app-soat-taxi (Laravel). Solo servidor: nunca usar el prefijo NEXT_PUBLIC_.
LAPOSITIVA_API_URL=http://app-soat-taxi.test/api
# Token personal de Laravel Sanctum. Se envía como "Authorization: Bearer <token>".
LAPOSITIVA_API_TOKEN=
# Cifra la cookie de sesión de la cotización. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Límites de uso (opcionales; los valores por defecto sirven para producción).
# Inicio: consultas por IP cada 10 min. Recotizar y catálogos: por sesión de cotización.
# RATE_LIMIT_START_PER_10_MIN=20
# RATE_LIMIT_REQUOTE_PER_10_MIN=10
# RATE_LIMIT_CATALOG_PER_MIN=60
# Crear la orden y cobrar (cada intento de pago cuenta dos): por sesión de cotización.
# RATE_LIMIT_CHECKOUT_PER_10_MIN=20
# Llave pública de Culqi Checkout (va al navegador; es la única variable pública permitida).
# pk_test_… en desarrollo, pk_live_… en producción. La llave secreta vive solo en la API.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
